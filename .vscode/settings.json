{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  // Pytest is pointed at one project at a time. The four projects cannot share
  // a single pytest process -- two of them define a top-level `app.py` and
  // `providers.py`, and sys.modules is global -- so the Testing panel is
  // configured for Task 4 by default. Change the `--rootdir`/path below to
  // explore another project, or use the "Tests: <task>" tasks which run each
  // suite in its own process.
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/fde-assessment/task4-rate-limit-router",
  "python.testing.pytestArgs": ["tests"],

  "python.analysis.extraPaths": [
    "${workspaceFolder}/fde-assessment/task1-mcp-server",
    "${workspaceFolder}/fde-assessment/task2-security-gateway",
    "${workspaceFolder}/fde-assessment/task3-pii-redaction-gateway",
    "${workspaceFolder}/fde-assessment/task4-rate-limit-router"
  ],

  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.sqlite3*": true
  }
}
